# Copy to .env (never commit .env). All values below are placeholders.
DATABASE_URL=jdbc:postgresql://db.example.internal:5432/smartattend?sslmode=require
DATABASE_USER=smartattend
DATABASE_PASSWORD=change-me

# Public URL students open. Used in QR codes and WebAuthn origin checks. Must be https in production.
SMARTATTEND_BASE_URL=https://attend.example.edu.gh
# WebAuthn relying-party ID = the host name of the base URL (no scheme / port).
SMARTATTEND_RP_ID=attend.example.edu.gh

# 32 random bytes each, base64. Generate with:  openssl rand -base64 32
# Losing SMARTATTEND_BIOMETRIC_KEY makes all face templates unreadable (students re-enrol).
SMARTATTEND_BIOMETRIC_KEY=
SMARTATTEND_HMAC_KEY=
SMARTATTEND_ALLOW_DEV_KEYS=false
SMARTATTEND_COOKIE_SECURE=true
# Set when behind a TLS-terminating proxy / load balancer so client IPs and https are detected.
FORWARD_HEADERS_STRATEGY=framework

# First start only: creates the initial Super Administrator (password must be changed at first sign-in).
SMARTATTEND_SUPERADMIN_EMAIL=
SMARTATTEND_SUPERADMIN_PASSWORD=
